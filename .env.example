# ==============================================
# Telegram Bot
# ==============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=-1000000000000
#TELEGRAM_ADMIN_IDS=123456789,987654321

# ==============================================
# Exchange API
# ==============================================
EXCHANGE=bingx
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
# Тип рынка для OHLCV:
#   spot  — спотовая торговля
#   swap  — perpetual futures (BingX USDT-M, Bybit)
#   future — expiring futures (Binance)
MARKET_TYPE=swap

# ==============================================
# Trading settings
# ==============================================
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
PRIMARY_TIMEFRAMES=1h,4h
CONFIRM_TIMEFRAME=15m

# ==============================================
# Strategy Mode (hot-swappable)
# ==============================================
# v2.5       — Current: BUY + filtered SELL, full pipeline (default)
# confluence — BOS + OB only, no reversals (use when live WR < 40%)
# hybrid     — 70/30 Confluence + v2.5 (future)
STRATEGY_MODE=v2.5

# ==============================================
# Direction / Symbol filters (Rec 3 — ex-hardcoded)
# ==============================================
# Блокировать все SELL-сигналы (историческая база: WR 33.7% / PnL -0.450% на 360d)
BLOCK_ALL_SELL=true
BLOCK_ALL_SELL_REASON=SELL blocked: WR 33.7% across 360d, negative PnL
# JSON {"SYMBOL": "buy|sell"} — блок направления по символу (WIF BUY: WR 28.8%/PnL -1.255%)
BLOCKED_SYMBOL_DIRECTIONS={"WIF/USDT": "buy"}
# Справочная статистика для отчётов (не влияет на логику)
DIRECTION_FILTER_STATS={"SELL": {"wr": 33.7, "pnl_pct": -0.450}, "WIF/USDT:buy": {"wr": 28.8, "pnl_pct": -1.255}}

# ==============================================
# Database
# ==============================================
DATABASE_URL=sqlite+aiosqlite:///./data/signals.db

# ==============================================
# Logging
# ==============================================
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ==============================================
# Indicator parameters (defaults shown — synced with config/settings.py)
# ==============================================
EMA_FAST=8
EMA_SLOW=21
EMA_TREND=55
RSI_PERIOD=10
RSI_OVERBOUGHT=72
RSI_OVERSOLD=28
RSI_BULL_MIN=55
RSI_BEAR_MAX=45
MACD_FAST=8
MACD_SLOW=21
MACD_SIGNAL=5
ADX_PERIOD=14
ADX_MIN=20
ADX_STRONG=22
ATR_PERIOD=14
ATR_MULTIPLIER_SL=1.5
ATR_MULTIPLIER_TP=3.0
MIN_SL_DISTANCE_PCT=1.0
MAX_SL_DISTANCE_PCT=10.0
STOP_HUNT_BUFFER_PCT=0.5
MAX_OB_DISTANCE_PCT=3.0
MIN_RR_THRESHOLD=1.5
# Upper bound for the planned TP: a target farther than MAX_TP_RR x SL cannot
# be reached inside OUTCOME_TTL_DAYS, so the trade would expire while still
# holding a portfolio slot. Candidates beyond the cap are dropped, the final
# TP is clamped. 0 = disabled.
MAX_TP_RR=6.0
SUPERTREND_PERIOD=10
SUPERTREND_MULTIPLIER=2.5
VOLUME_FACTOR=1.5
VOLUME_SMA_PERIOD=20
CANDLES_LIMIT=200
COMPRESSION_VOLUME_FACTOR=2.0

# Max bars a trade can stay open before forced close at current price (0 = disabled).
# Prevents stale trades from dragging down win rate. Recommended: 48-72 for 4h TF.
MAX_TRADE_DURATION_BARS=72
# Days before an unresolved signal is closed as EXPIRED at the current price
# (live: scheduler/outcome_tracker.py; backtest: same rule in bars).
OUTCOME_TTL_DAYS=7

# ==============================================
# Filter toggles — signal engine gates
# ==============================================
EMA_SLOPE_CHECK=false
MACD_SLOPE_CHECK=false
ADX_FILTER_ENABLED=true
EMA_ALIGNMENT_ENABLED=true
EMA_SPREAD_ENABLED=true
TRIGGER_REQUIRED=true
CANDLE_CLOSE_ENABLED=true
MIN_SCORE_ENABLED=true
COMPRESSION_ENABLED=true

# ==============================================
# Market Structure
# ==============================================
DISTANCE_FILTER_MIN_PCT=1.2
MTF_ENABLED=true
MTF_REQUIRED_ALIGNMENT=2
MTF_TIMEFRAMES=1d,4h,1h

# ==============================================
# Pattern Engine
# ==============================================
# Maximum distance (%) from current price to FVG median to use as entry (default: 5%)
# If FVG is farther than this, entry falls back to candle close
PATTERN_FVG_PROXIMITY_PCT=5.0

# ==============================================
# Derivatives
# ==============================================
FUNDING_STRONG_THRESHOLD=0.0003
FUNDING_NEUTRAL_ZONE=0.0001
OI_MODERATE_THRESHOLD=0.5
OI_STRONG_THRESHOLD=2.0
OI_LOOKBACK_HOURS=24
BTC_SYMBOL=BTC/USDT
BTC_EMA200_TIMEFRAME=4h
BTC_CORRELATION_ENABLED=true
ETH_SYMBOL=ETH/USDT
ETH_CORRELATION_SYMBOLS=OP/USDT,ARB/USDT
ETH_CORRELATION_ENABLED=true

# ==============================================
# Risk & Volatility
# ==============================================
VOLATILITY_LOW_THRESHOLD=0.8
VOLATILITY_HIGH_THRESHOLD=6.0
VOLATILITY_ATR_PERIOD=14
RISK_STRONG_PCT=1.0
RISK_MODERATE_PCT=0.5
MIN_SCORE_FOR_SIGNAL=2
RISK_WEAK_TRADE=false
RISK_WEAK_PCT=0.25
NO_TRADE_MIN_ATR_PCT=0.6

# ==============================================
# Context
# ==============================================
CONTEXT_MIN_VERDICT=WEAK

# ==============================================
# News Filter (Rec 4a, opt-in)
# ==============================================
# Включить фильтр новостей (события из config/macro_events.json)
NEWS_FILTER_ENABLED=false
NEWS_EVENTS_FILE=config/macro_events.json
NEWS_BLOCK_BEFORE_MINUTES=60
NEWS_BLOCK_AFTER_MINUTES=30

# ==============================================
# Scoring
# ==============================================
QUALITY_STRONG_THRESHOLD=65
QUALITY_MODERATE_THRESHOLD=40

# ==============================================
# Web Dashboard
# ==============================================
WEB_ENABLED=true
WEB_PORT=3001
WEB_HOST=0.0.0.0
WEB_UPDATE_INTERVAL=5

# ==============================================
# Signal-recovery flags (Phase 3)
# Each default preserves the CURRENT live behavior. Flip one at a time and
# re-validate on the backtest before enabling in production.
# ==============================================
# HTF bias on continuation setups: true = hard-block a continuation that opposes
# the HTF bias (current); false = keep it but penalise P(TP). This wires the
# previously-unused HTF_HARD_GATE flag to the continuation gate.
HTF_HARD_GATE=true
# P(TP) multiplier applied when HTF_HARD_GATE=false and a continuation opposes bias.
HTF_BIAS_CONTINUATION_PENALTY=0.85
# Reversal displacement gate: true = require the current candle to be a displacement
# candle (current); false = informational only (sweep + MSS already gate the reversal).
REVERSAL_REQUIRE_DISPLACEMENT=true
# true = only emit when price is inside the OB/FVG entry zone (stop chasing at close);
# false = current behavior (entry_armed is log-only, entry taken at close).
REQUIRE_ENTRY_ZONE=false
# Minimum P(TP) to emit a signal (0.0 = disabled/current). >0 makes the Probability
# Engine an actual selector instead of a sizing-only input.
# NOTE: backtest-only — live scan_symbol_v2 does not read min_p_tp.
MIN_P_TP=0.0

# ==============================================
# Keys tuned in production .env but missing from this file before
# (values below are the code defaults unless noted)
# ==============================================

# ─── Cooldown / portfolio limits ───
# Effective cooldown = max(base, tf_minutes × multiplier). Persisted in SQLite.
SIGNAL_COOLDOWN_MINUTES=45
SIGNAL_COOLDOWN_TF_MULTIPLIER=2.0
MAX_ACTIVE_SIGNALS=5
MAX_ACTIVE_SIGNALS_PER_SYMBOL=1

# ─── Risk Engine ───
# Soft gate (logged, NOT enforced) — risk/engine.py "Hard gates" docstring is
# aspirational for the SL cap. Hard enforcement comes from MAX_SL_ATR in the
# trade engine (structural invalidation + wick safety must fit in 3 ATR).
RISK_ENGINE_SL_MAX_PCT=1.5
# Per-trade risk ceiling (Kelly cap in risk/engine.py): 5 slots x 0.6% = 3.0% budget
RISK_ENGINE_BASE_RISK_PCT=0.6

# ─── Trade engine ───
# Max SL distance in ATR; violations reject the trade plan (sl_tp gate).
MAX_SL_ATR=3.0
ATR_MULTIPLIERS_PER_TF={"1h": {"sl": 2.0, "tp": 4.0}, "4h": {"sl": 2.5, "tp": 5.0}}

# ─── Indicator thresholds ───
MIN_EMA_SPREAD_PCT=0.20
MIN_MACD_PCT=0.03
DELTA_BULLISH=15
DELTA_BEARISH=-15
REGIME_TREND_ADX=25

# ─── Pattern engine ───
PATTERN_MAX_SWEEP_AGE_BARS=40
PATTERN_POI_ENTRY_ENABLED=true
PATTERN_POI_MIN_QUALITY=30

# ─── Per-symbol overrides (JSON: symbol -> {adx_min, max_sl_pct, ...}) ───
SYMBOL_OVERRIDES={}

# ─── Telegram ───
# Channel the signals go to; admin ids that may talk to the bot in DM.
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=

# ─── Non-Binance exchange credentials (leave empty if unused) ───
BYBIT_API_KEY=
BYBIT_API_SECRET=
